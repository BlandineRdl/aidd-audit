{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(aws iam:*)",
      "Read(./secrets/**)",
      "Read(./**/.env*)"
    ]
  }
}

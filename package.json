{
  "name": "aidd-audit",
  "version": "0.1.0",
  "description": "Evaluation de maturite AIDD basee sur des preuves. Deterministe, hors ligne, explicable.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "architecture": "depcruise src && node scripts/prove-boundary-rules.mjs",
    "comments": "node scripts/check-comment-tags.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm architecture && pnpm comments",
    "build": "tsup",
    "prepare": "lefthook install"
  },
  "keywords": [],
  "author": "Black Sun",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "aidd-audit": "./dist/cli.js"
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.0",
    "dependency-cruiser": "^18.2.0",
    "lefthook": "^2.1.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}

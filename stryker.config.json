{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "htmlReporter": {
    "fileName": ".stryker-tmp/mutation-report.html"
  },
  "mutate": [
    "src/maturity/loading/**/*.ts",
    "src/maturity/engine/**/*.ts",
    "src/maturity/models/**/*.ts",
    "src/evidence/adapters/harness/**/*.ts",
    "src/evidence/resolution/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-fixture.ts",
    "!src/**/*.test-adapter.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "ignoreStatic": true
}
